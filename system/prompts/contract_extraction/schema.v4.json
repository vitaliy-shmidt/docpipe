{
  "type": "object",
  "properties": {
    "vendor_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_person": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "is_open_ended": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notice_period": {
      "type": [
        "string",
        "null"
      ]
    },
    "notice_period_value": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "notice_period_unit": {
      "enum": [
        "days",
        "weeks",
        "months",
        "years",
        null
      ]
    },
    "renewal_terms": {
      "type": [
        "string",
        "null"
      ]
    },
    "auto_renewal": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "renewal_period_value": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "renewal_period_unit": {
      "enum": [
        "days",
        "weeks",
        "months",
        "years",
        null
      ]
    },
    "amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "payment_interval": {
      "enum": [
        "monthly",
        "quarterly",
        "semiannual",
        "annual",
        "one_time",
        "other",
        null
      ]
    },
    "customer_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 250
    },
    "customer_address": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "street": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 150
            },
            "zip": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 20
            },
            "city": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            }
          },
          "required": [
            "street",
            "zip",
            "city"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sites": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 250
          },
          "street": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "zip": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        },
        "required": [
          "name",
          "street",
          "zip",
          "city"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 250
          },
          "serial_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "location": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 250
          }
        },
        "required": [
          "name",
          "serial_number",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "vendor_name",
    "contact_person",
    "contract_type",
    "contract_number",
    "service_description",
    "start_date",
    "end_date",
    "is_open_ended",
    "notice_period",
    "notice_period_value",
    "notice_period_unit",
    "renewal_terms",
    "auto_renewal",
    "renewal_period_value",
    "renewal_period_unit",
    "amount",
    "currency",
    "payment_interval",
    "customer_name",
    "customer_address",
    "sites",
    "assets",
    "notes"
  ],
  "additionalProperties": false
}

  "info": {
    "description": "Extract of DocPipe's generated OpenAPI document. Contract and behaviour: docs/forms-inspect.md. Authentication: Authorization: Bearer <api key> of a client with services.forms.",
    "title": "DocPipe forms API (PDF4Fill): inspect and fill",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/documents/forms/fill": {
      "post": {
        "description": "Native fields by native_ref, overlay fields and PNG images by page + position (inspect coordinates), bundled Unicode fonts, auto-fit, no truncation. The manifest is a JSON string; its schema is in x-docpipe-manifest-schema. See docs/forms-fill.md.",
        "operationId": "forms_fill_api_v1_documents_forms_fill_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_forms_fill_api_v1_documents_forms_fill_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The filled, flattened PDF (`Cache-Control: no-store`). An encrypted template yields an output with the same encryption and permissions."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`invalid_file`, `invalid_request`, `invalid_manifest`, `invalid_image`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`unauthorized`"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`forms_disabled`"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`hash_mismatch`"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`file_too_large`, `limit_exceeded`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`password_required`, `invalid_password`, `xfa_unsupported`, `permission_denied`, `signature_conflict`, `unknown_field`, `field_conflict`, `invalid_geometry`, `invalid_value`, `text_overflow`, `unsupported_characters`"
          }
        },
        "summary": "Fill a PDF form template and return a flattened PDF (PDF4Fill, services.forms)",
        "x-docpipe-manifest-schema": {
          "$defs": {
            "FillField": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "Caller's id; echoed in error details only",
                  "pattern": "^[A-Za-z0-9_.:\\-]{1,64}$",
                  "title": "Id",
                  "type": "string"
                },
                "image_ref": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9_.:\\-]{1,64}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Images: filename of one `images` part",
                  "title": "Image Ref"
                },
                "input_name": {
                  "anyOf": [
                    {
                      "maxLength": 1024,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "mode=native: optional check",
                  "title": "Input Name"
                },
                "mode": {
                  "enum": [
                    "native",
                    "overlay"
                  ],
                  "title": "Mode",
                  "type": "string"
                },
                "native_ref": {
                  "anyOf": [
                    {
                      "maxLength": 64,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "mode=native: from inspect",
                  "title": "Native Ref"
                },
                "page": {
                  "anyOf": [
                    {
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "mode=overlay: required; native: optional check",
                  "title": "Page"
                },
                "position": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FillPosition"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "mode=overlay: required; native: check"
                },
                "required": {
                  "default": false,
                  "title": "Required",
                  "type": "boolean"
                },
                "style": {
                  "$ref": "#/$defs/FillStyle"
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "date",
                    "choice",
                    "checkbox",
                    "radio",
                    "stamp_image",
                    "signature_image"
                  ],
                  "title": "Type",
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {

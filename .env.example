# Copy to .env for local use. All of these are optional overrides;
# see README.md for the full precedence order.

# Path to the YAML config file (default: config.yaml)
DOCPIPE_CONFIG=config.yaml

# Overrides for the [stirling] section of the config file
STIRLING_URL=http://localhost:8080
STIRLING_API_KEY=
STIRLING_TIMEOUT=90

# Override for the [ollama] section of the config file (V2.1, optional).
# Model/timeout/temperature are no longer set here - they come from the
# named model profile a mode resolves to (config.yaml's `models:` section).
OLLAMA_URL=http://localhost:11434
